{
  "name": "visit-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visit Buddy — a voice-first app that helps you prepare for a doctor visit and understand it afterward.",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:https": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client:https\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev:client:https": "npm --prefix client run dev:https",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test:redflags": "node client/src/services/redFlags.test.mjs",
    "test:knowledge": "node server/rag/check-knowledge.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
