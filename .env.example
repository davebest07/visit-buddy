# Visit Buddy server configuration.
# Copy this file to .env and fill in the key. .env is git-ignored.

PORT=3001

# Google Gemini API key. Create one at https://aistudio.google.com/apikey
# The free tier needs no card and no billing account.
# Without a key the app still runs, but every AI action explains that it is not
# configured instead of answering.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash, which is on the free tier and answered
# reliably when tested. Other free-tier options: gemini-3.5-flash, gemini-3.5-flash-lite.
# Known traps: gemini-2.5-* now returns 404 "no longer available to new users", and
# gemini-3.8-flash has been returning 503 "high demand" intermittently.
# GEMINI_MODEL=gemini-3.6-flash

# Optional. Milliseconds before an AI request gives up. Defaults to 60000.
# Transient 5xx answers are retried twice (800 ms, then 2 s) before this applies.
# AI_TIMEOUT_MS=60000
